# Keep real values in a private .env.local or deployment SSM, never in git.
PUBLIC_ORIGIN=http://127.0.0.1:3000
AUTH_URL=http://127.0.0.1:3000
AUTH_SECRET=
PORTFOLIO_AUTH_ENABLED=1
DATABASE_URL=
DATABASE_NAME=model_arena
# Development-only loopback PostgreSQL may use disable. AWS requires the CA file.
DATABASE_SSL=disable
DATABASE_SSL_CA_FILE=
MODEL_ARENA_MOCK_MODE=1
HF_TOKEN=
# Grading uses a user-supplied session key in Configure; no shared grader key.
MODEL_ARENA_OWNER_BUDGET_USD=0.02
MODEL_ARENA_SHARED_BUDGET_USD=0.10
# Production-build loopback QA only; never set this flag in AWS.
# Requires loopback origin/database, no provider keys, mock1 and bind127.0.0.1.
MODEL_ARENA_LOCAL_PREVIEW=0
MODEL_ARENA_BIND_HOST=127.0.0.1
