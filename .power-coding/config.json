{
  "version": "1.0.0",
  "consent": {
    "git_checkpoints": "ask",
    "fmea_full_scan": "ask",
    "paid_evals": "ask"
  },
  "modules": {
    "fmea": {
      "enabled": true,
      "triggers": {
        "on_feature_complete": false,
        "on_pre_commit": false,
        "smart_suggest": false,
        "manual_only": true
      },
      "smart_suggest_signals": [
        "diff_exceeds_lines:200",
        "new_external_api_integration",
        "payment_billing_logic_touched",
        "async_queue_worker_modified",
        "error_handling_changed",
        "auth_access_control_touched",
        "database_migration_added",
        "environment_config_changed",
        "new_webhook_handler",
        "retry_logic_modified"
      ],
      "scoring": {
        "p0_threshold": 200,
        "p1_threshold": 100,
        "p2_threshold": 0
      },
      "failure_categories": [
        "unhandled_error_paths",
        "external_dependency_failures",
        "race_conditions_and_state",
        "resource_exhaustion",
        "security_access_control",
        "data_integrity_partial_writes",
        "observability_gaps",
        "scale_and_load_failures",
        "billing_credit_mismatches",
        "retry_idempotency_issues",
        "config_feature_flag_drift",
        "edge_cases_from_prd"
      ],
      "context_sources": {
        "prd_path": "README.md",
        "architecture_doc": "docs/ARCHITECTURE_FLOW.md",
        "known_incidents": "Learning.MD",
        "infra_constraints": "docs/PORTFOLIO-DEPLOYMENT.md"
      },
      "output": {
        "format": "csv_and_json_with_markdown_report",
        "include_rpn": true,
        "include_recommended_actions": true,
        "include_priority_badges": true,
        "max_failure_modes": 150,
        "sort_by": "rpn_desc"
      }
    },
    "sentinel": {
      "enabled": false,
      "manual_only": true
    },
    "session_pulse": {
      "enabled": false
    },
    "security_baseline": {
      "done": true,
      "completed_date": "2026-10-02",
      "evidence": "Tracked secret-pattern scan had no matches; env files ignored; server-side auth/CSRF/budget/parameterized SQL reviewed; PostgreSQL TLS override regression fixed."
    }
  },
  "task_authorization": "2026-10-02: user explicitly requested full12-category FMEA and at least100 scenarios, free QA first. No paid calls/deploy/commit/push by worker before root review."
}
